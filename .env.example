# Gemma 4 served by vLLM on AMD Instinct (OpenAI-compatible)
FOREMAN_LLM_BASE_URL=http://127.0.0.1:8000/v1
FOREMAN_LLM_MODEL=google/gemma-4-31B-it
FOREMAN_LLM_API_KEY=EMPTY
# live | mock   (mock = offline stand-in for UI work; never demo with it)
FOREMAN_LLM_MODE=live

# PatchCore
FOREMAN_CATEGORY=metal_nut
FOREMAN_DEVICE=auto
FOREMAN_CORESET_RATIO=0.1

# Line simulation
FOREMAN_TICK_S=4
FOREMAN_AUTOSTART=false

# Hugging Face token (only if the model requires accepting a licence)
HF_TOKEN=
